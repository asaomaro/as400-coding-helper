{
  // dds-core と同じ理由で "types" を ["node"] に固定する（AC9 の波及防止）。
  // CLI も vscode に依存しない——依存すると headless で動かなくなり、CLI の存在意義が消える。
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "out"]
}
