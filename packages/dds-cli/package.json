{
  "name": "@as400/dds-cli",
  "version": "0.0.0",
  "private": true,
  "description": "dds-core を headless に叩く CLI。AI エージェントからも人間からも同じコアを使うための経路。",
  "license": "UNLICENSED",
  "main": "./out/src/main.js",
  "bin": {
    "dds": "./bin/dds.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync(process.argv[1],{recursive:true,force:true})\" out",
    "build": "npm run clean && tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run build && node ../../scripts/run-node-tests.mjs out/test"
  },
  "dependencies": {
    "@as400/dds-core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
