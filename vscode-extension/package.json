{
  "name": "rpg-cl-vscode-support",
  "displayName": "RPG/CL Development Support",
  "description": "Fixed-format RPG and CL editing support with F4-style prompter for AS400 / IBM i developers.",
  "version": "0.0.1",
  "publisher": "as400-coding-helper",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:rpg-fixed",
    "onLanguage:cl",
    "onCommand:rpgClSupport.showPrompter",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rpg-fixed",
        "aliases": [
          "RPG Fixed",
          "RPG (Fixed Format)"
        ],
        "extensions": [
          ".rpgle",
          ".rpg"
        ],
        "configuration": "./language-configuration/rpg-fixed-language.json"
      },
      {
        "id": "cl",
        "aliases": [
          "CL",
          "Control Language"
        ],
        "extensions": [
          ".clp"
        ],
        "configuration": "./language-configuration/cl-language.json"
      }
    ],
    "grammars": [
      {
        "language": "rpg-fixed",
        "scopeName": "source.rpgle",
        "path": "./resources/language/rpg-fixed.tmLanguage.json"
      },
      {
        "language": "cl",
        "scopeName": "source.cl",
        "path": "./resources/language/cl.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "rpgClSupport.ddsVisualEditor",
        "displayName": "DDS ビジュアルエディタ",
        "selector": [
          {
            "filenamePattern": "*.dspf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "rpgClSupport.showPrompter",
        "title": "RPG/CL: Show F4 Prompter"
      },
      {
        "command": "rpgClSupport.toggleComment.rpg",
        "title": "RPG/CL: Toggle Comment (RPG)"
      },
      {
        "command": "rpgClSupport.toggleComment.cl",
        "title": "RPG/CL: Toggle Comment (CL)"
      },
      {
        "command": "rpgClSupport.rpgTabNext",
        "title": "RPG/CL: Tab to Next Keyword Column"
      },
      {
        "command": "rpgClSupport.rpgTabPrevious",
        "title": "RPG/CL: Tab to Previous Keyword Column"
      },
      {
        "command": "rpgClSupport.ruler.cycleMode",
        "title": "RPG/CL: Toggle Ruler Display"
      }
    ],
    "keybindings": [
      {
        "command": "rpgClSupport.toggleComment.rpg",
        "key": "ctrl+/",
        "when": "editorLangId == rpg-fixed && editorTextFocus"
      },
      {
        "command": "rpgClSupport.toggleComment.cl",
        "key": "ctrl+/",
        "when": "editorLangId == cl && editorTextFocus"
      },
      {
        "command": "rpgClSupport.showPrompter",
        "key": "f4",
        "when": "editorTextFocus && ((editorLangId == rpg-fixed || editorLangId == cl) || (resourceExtname == .rpgle || resourceExtname == .clp))"
      },
      {
        "command": "rpgClSupport.rpgTabNext",
        "key": "tab",
        "when": "editorTextFocus && (editorLangId == rpg-fixed || editorLangId == cl)"
      },
      {
        "command": "rpgClSupport.rpgTabPrevious",
        "key": "shift+tab",
        "when": "editorTextFocus && (editorLangId == rpg-fixed || editorLangId == cl)"
      }
    ],
    "configuration": {
      "title": "RPG/CL Development Support",
      "properties": {
        "rpgClSupport.cNewOpcodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "EVAL",
            "EVALR",
            "IF",
            "ELSEIF",
            "ELSE",
            "ENDIF",
            "SELECT",
            "WHEN",
            "OTHER",
            "ENDSL"
          ],
          "description": "C 仕様書で「新形式」として扱うオペコードの一覧です。ここに列挙されたオペコードは C-NEW プロンプターで扱われ、それ以外は従来形式（C-SPEC）として扱われます。"
        },
        "rpgClSupport.rpgDialectByExtension": {
          "type": "object",
          "default": {
            ".rpgle": "ile",
            ".rpg": "rpg3"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "ile",
              "rpg3"
            ]
          },
          "markdownDescription": "RPG 固定長ソースの拡張子→方言(`ile`=ILE/RPG IV / `rpg3`=RPG III/RPG400)対応です。プロンプター定義の読込先(`resources/prompter/rpg/{dialect}/`)と桁解決の方言を決めます。`.rpg` を ILE として扱う等の上書きに使います。"
        },
        "rpgClSupport.prompter.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "F4 プロンプターをソースと同じエディターグループではなく、右側のエディターグループに新規タブとして表示します。"
        },
        "rpgClSupport.ruler.defaultMode": {
          "type": "string",
          "enum": [
            "off",
            "ruler",
            "full"
          ],
          "enumDescriptions": [
            "ルーラーを表示しません。",
            "桁目盛り段のみ表示します。",
            "桁目盛り段とフィールド境界段の両方を表示します。"
          ],
          "default": "full",
          "description": "ルーラー表示の初期モードです。ステータスバーのクリックで off → ruler → full と循環します。状態はワークスペース単位で保持されます。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run typecheck:webview && npm run bundle -- --production",
    "build": "npm run compile && npm run typecheck:webview && npm run bundle",
    "bundle": "node esbuild.mjs",
    "dev:standalone": "node dev/build-standalone.mjs",
    "dev:e2e": "node dev/e2e.mjs",
    "compile": "tsc -p ./",
    "typecheck:webview": "tsc -p tsconfig.webview.json",
    "watch": "tsc -w -p ./",
    "clean:test": "node -e \"require('node:fs').rmSync(process.argv[1],{recursive:true,force:true})\" out-test",
    "typecheck:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run typecheck:test && mocha --ui tdd \"out-test/test/unit/**/*.test.js\"",
    "test:integration": "npm run typecheck:test && node out-test/test/runTests.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.3.0",
    "esbuild": "^0.28.2",
    "glob": "^10.3.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@as400/dds-core": "*"
  }
}
