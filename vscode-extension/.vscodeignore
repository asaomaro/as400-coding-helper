# VSIX に入れないもの。実行に要るのは out/・resources/・language-configuration/・
# package.json と、実行時の依存（ssh2 とその依存）だけ。
#
# これが無いと、テスト（out-test/・test/）・ソース（src/）・検証用ハーネスの出力（dev/out/）・
# e2e 用に --no-save で入れた playwright-core まで同梱される（2026-09-27 に 1701 ファイル）。

# ソースとビルドの設定
# アイコンの元絵（SVG）。同梱するのは書き出した images/icon.png だけ。
images/*.svg
src/**
**/tsconfig*.json
esbuild.webview.mjs
**/*.map
.gitignore

# テストと検証
test/**
out-test/**
out-integration/**
.vscode-test/**
dev/**
scripts/**
node_modules/playwright-core/**

# 旧ビルドの残り（いまの main は out/extension/extension.js）
dist/**
