{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "mocha",
      "vscode"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    // WebView 側（ブラウザで動くコード）は DOM の型が要るので、
    // 型検査は tsconfig.webview.json で行う。実体は esbuild が dist/webview/ へ束ねる。
    // ここに残すと lib に DOM が無いため落ちる。protocol.ts は拡張ホスト側も使うので除外しない。
    "src/dds/webview/main.ts",
    "src/dds/webview/bridge.ts",
    "src/dds/webview/ui.ts",
    "src/dds/webview/css.d.ts"
  ]
}
