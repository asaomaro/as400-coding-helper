{
  // ユニットテスト用。src とテストを一緒に out-test へ出す。
  // 本体の tsconfig は rootDir が src なのでテストを含められない。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./out-test",
    "sourceMap": false
  },
  "include": ["src", "test/unit"],
  "exclude": ["node_modules", ".vscode-test", "out", "out-test",
    "src/prompter/webview/ui.ts",
    "src/prompter/webview/bridge.ts",
    "src/prompter/webview/main.ts",
    "src/dds/webview/ui.ts",
    "src/dds/webview/bridge.ts",
    "src/dds/webview/main.ts",
    "src/dds/webview/css.d.ts",
    "dev"
  ]
}
