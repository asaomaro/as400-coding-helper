{
  "version": "2.0.0",
  "tasks": [
    {
      // path で サブフォルダの package.json を使う。ルートには compile が無い。
      //
      // **`compile` だけでは足りない。** DDS ビジュアルエディタと F4 プロンプターの
      // 画面は esbuild で `out/*-webview/` へ束ねており、tsc は作らない。
      // ここを `compile` のままにすると、F5 で起動した拡張の**画面が真っ白になる**
      // （例外も出ないので原因が分かりにくい）。
      "type": "npm",
      "script": "compile:all",
      "path": "vscode-extension",
      "label": "npm: compile - vscode-extension",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "type": "npm",
      "script": "verify",
      "path": "vscode-extension",
      "label": "npm: verify - vscode-extension",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
